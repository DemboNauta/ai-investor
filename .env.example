# xAI / Grok
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-3

# Twitter/X bot — OAuth 1.0a (Keys & Tokens en developer.x.com)
X_CONSUMER_KEY=
X_CONSUMER_KEY_SECREY=
X_ACCESS_TOKEN=
X_SECRET_ACCESS_TOKEN=
# TWITTER_ENABLED=false  # descomenta para deshabilitar

# Intervalo entre ciclos en horas (decimales OK: 0.5 = 30min, 4 = 4h)
CYCLE_INTERVAL_HOURS=1

# Email notifications (Gmail recommended)
# For Gmail: enable 2FA and generate an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
NOTIFY_EMAIL=edgarxiaomi10744@gmail.com

